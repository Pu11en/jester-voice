# Stable runtime concepts only. Final variables may change after machine/EBI inspection.

# Required Discord bot credential
DISCORD_TOKEN=

# Owner identity for privileged voice/control actions
DISCORD_OWNER_ID=

# Likely Discord scope (fill after bot/channel creation)
DISCORD_GUILD_ID=
DISCORD_VOICE_CHANNEL_ID=

# Existing EBI / ccdb control surface (final names/auth depend on current runtime)
EBI_BASE_URL=
# EBI_CONTROL_SECRET=

# Brain is intended to use local Codex subscription authentication, not an OpenAI API key.
# Do not add OPENAI_API_KEY unless the owner explicitly changes the architecture later.

