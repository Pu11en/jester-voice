# Copy to .env and fill in this machine's Discord room IDs.
# Never put the bot token or owner ID here; they come from the EBI env file.
DISCORD_GUILD_ID=
DISCORD_VOICE_CHANNEL_ID=
DISCORD_TRANSCRIPT_CHANNEL_ID=

# Optional overrides; the defaults use the existing benchmark install and models.
JESTER_EBI_ENV_FILE=/home/drewp/main-projects/ebi-agent-chat-relay/.env
JESTER_PYTHON=/home/drewp/main-projects/jester-voice/bench/.venv/bin/python
JESTER_MODELS_DIR=/home/drewp/main-projects/jester-voice/bench/data/models
